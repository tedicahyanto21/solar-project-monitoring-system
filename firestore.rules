// =========================================================================
// SPMS Firestore Security Rules -- DEVELOPMENT DRAFT
// =========================================================================
//
// STATUS: DRAFT / NOT REVIEWED / NOT FOR PRODUCTION DEPLOYMENT.
//
// This file prepares the rules ARCHITECTURE described in the Firestore
// Security Design (SPMS-DOC-07) so it exists somewhere concrete and
// version-controlled, per Sprint FT-8 Part I. It has NOT been deployed,
// has NOT been tested against a real Firebase project (none exists for
// SPMS yet), and must be reviewed by the Technical Lead and tightened
// before any production use. Final production rules are a separate,
// later review (per FT-8 instructions: "Final production rules will be
// reviewed separately").
//
// Source of truth for the policy encoded below:
//   - SPMS-DOC-07, Section 6 (Collection Access Matrix)
//   - SPMS-DOC-07, Section 7 (Cost Transaction Security -- sourceRole
//     must match the authenticated user's own role; VOID not delete)
//   - SPMS-DOC-07, Section 10 (BOD: Dashboard-only, read-only)
//   - SPMS-DOC-07, Section 11 (User Management: Super Admin only)
//   - Sprint FT-7 Part A2 (INACTIVE users denied access)
//
// KNOWN GAPS (deliberately not solved here -- flagged for the later
// production review rather than guessed at):
//   - Duplicate-transaction enforcement (Database Design SPMS-DOC-06,
//     Section 15) needs a transactional write with the duplicateControls
//     document, which these declarative rules can only partially express
//     (they can restrict who writes it, not the multi-document atomicity).
//   - Project assignment lookups below assume a document read per request
//     (get()); at scale this should be reconsidered for cost/latency.
//
// =========================================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ---------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myRole() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? myProfile().role
        : null;
    }

    function amActive() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myProfile().status == 'ACTIVE';
    }

    // FT-7 A2: an INACTIVE (or profile-less) user is treated as having no
    // access at all, regardless of role.
    function isAuthorized() {
      return isSignedIn() && amActive();
    }

    function hasRole(roles) {
      return isAuthorized() && myRole() in roles;
    }

    function isSuperAdmin() {
      return hasRole(['SUPER_ADMIN']);
    }

    function isAssignedToProject(projectId) {
      return isAuthorized() && exists(
        /databases/$(database)/documents/projects/$(projectId)/projectAssignments/$(request.auth.uid)
      );
    }

    // ---- users -------------------------------------------------------------
    // SPMS-DOC-07 Section 11: Super Admin only for CRUD. A user may read
    // their own profile (needed to resolve their own role/status).
    match /users/{userId} {
      allow read: if isSuperAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow write: if isSuperAdmin();
    }

    // ---- projects and subcollections ---------------------------------------
    match /projects/{projectId} {
      // Portfolio-wide read (Dashboard, BOD) vs. assigned-project read for
      // operational roles -- SPMS-DOC-07 Section 6.
      allow read: if hasRole(['SUPER_ADMIN', 'HEAD_PM', 'BOD']) || isAssignedToProject(projectId);
      allow create: if hasRole(['SUPER_ADMIN', 'HEAD_PM']);
      allow update: if hasRole(['SUPER_ADMIN', 'HEAD_PM', 'PROJECT_MANAGER']);
      allow delete: if isSuperAdmin(); // archive in application logic, not a hard delete pattern

      match /projectAssignments/{userId} {
        allow read: if hasRole(['SUPER_ADMIN', 'HEAD_PM']) || isAssignedToProject(projectId);
        allow write: if hasRole(['SUPER_ADMIN', 'HEAD_PM', 'PROJECT_MANAGER']);
      }

      match /progressHistory/{snapshotId} {
        allow read: if hasRole(['SUPER_ADMIN', 'HEAD_PM', 'BOD']) || isAssignedToProject(projectId);
        // Snapshots are system-generated by the Progress Engine, not
        // hand-edited -- restrict writes to the roles that drive progress.
        allow write: if hasRole(['SUPER_ADMIN']) || isAssignedToProject(projectId);
      }

      match /engineeringDocuments/{docId} {
        allow read: if hasRole(['SUPER_ADMIN', 'HEAD_PM', 'BOD']) || isAssignedToProject(projectId);
        allow write: if hasRole(['SUPER_ADMIN', 'ENGINEERING']) && isAssignedToProject(projectId) || isSuperAdmin();
      }

      match /hseItems/{itemId} {
        allow read: if hasRole(['SUPER_ADMIN', 'HEAD_PM', 'BOD']) || isAssignedToProject(projectId);
        allow write: if hasRole(['SUPER_ADMIN', 'HSE']) && isAssignedToProject(projectId) || isSuperAdmin();
      }

      match /procurementMilestones/{milestoneId} {
        allow read: if hasRole(['SUPER_ADMIN', 'HEAD_PM', 'BOD']) || isAssignedToProject(projectId);
        allow write: if hasRole(['SUPER_ADMIN', 'SCM']) && isAssignedToProject(projectId) || isSuperAdmin();
      }

      match /constructionActivities/{activityId} {
        allow read: if hasRole(['SUPER_ADMIN', 'HEAD_PM', 'BOD']) || isAssignedToProject(projectId);
        allow write: if hasRole(['SUPER_ADMIN', 'SITE_MANAGER']) && isAssignedToProject(projectId) || isSuperAdmin();
      }

      match /commissioningItems/{itemId} {
        allow read: if hasRole(['SUPER_ADMIN', 'HEAD_PM', 'BOD']) || isAssignedToProject(projectId);
        allow write: if hasRole(['SUPER_ADMIN', 'ENGINEERING', 'SITE_MANAGER']) && isAssignedToProject(projectId) || isSuperAdmin();
      }

      match /issues/{issueId} {
        allow read: if hasRole(['SUPER_ADMIN', 'HEAD_PM', 'BOD']) || isAssignedToProject(projectId);
        // FT-6 A2: Super Admin, Project Manager, Site Manager may create/
        // edit/close/reopen; assignment scope still applies.
        allow write: if hasRole(['SUPER_ADMIN', 'PROJECT_MANAGER', 'SITE_MANAGER']) && isAssignedToProject(projectId) || isSuperAdmin();
      }

      match /costTransactions/{transactionId} {
        allow read: if hasRole(['SUPER_ADMIN', 'HEAD_PM', 'PROJECT_MANAGER', 'FINANCE']) || isAssignedToProject(projectId);
        // FT-5 B2/B9: SCM/HC/FINANCE create; sourceRole must equal the
        // caller's own role (no impersonation); POSTED transactions are
        // never deleted, only voided (handled as an update, not delete).
        //
        // FT-5→FT-8 Consolidation Section 14 (CRITICAL): only FINANCE (or
        // Super Admin) may submit transactionType == 'PAYMENT_ONLY' -- SCM
        // and HC transactions are always a new incurred COST, never a
        // payment settling something else, so they cannot use the field
        // that exists specifically to avoid double-counting a payment.
        allow create: if hasRole(['SUPER_ADMIN', 'SCM', 'HC', 'FINANCE'])
          && isAssignedToProject(projectId)
          && (isSuperAdmin() || request.resource.data.sourceRole == myRole())
          && (request.resource.data.transactionType != 'PAYMENT_ONLY' || hasRole(['SUPER_ADMIN', 'FINANCE']));
        allow update: if hasRole(['SUPER_ADMIN'])
          || (hasRole(['SCM', 'HC', 'FINANCE']) && resource.data.sourceRole == myRole() && isAssignedToProject(projectId));
        allow delete: if false; // normal workflow is VOID (an update), never delete
      }

      match /paymentProjections/{projectionId} {
        allow read: if hasRole(['SUPER_ADMIN', 'HEAD_PM', 'PROJECT_MANAGER', 'FINANCE']) || isAssignedToProject(projectId);
        // FT-5 B2/B5: SCM and Super Admin only.
        allow write: if hasRole(['SUPER_ADMIN', 'SCM']) && isAssignedToProject(projectId) || isSuperAdmin();
      }
    }
  }
}
